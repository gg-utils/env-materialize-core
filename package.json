{
  "name": "@gg-utils/env-materialize-core",
  "version": "0.2.0",
  "description": "Product-neutral env materialization primitives for parsing and rendering env files.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./env-document": {
      "types": "./dist/env-document.d.ts",
      "default": "./dist/env-document.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0 <27",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test \"src/**/*.unit.test.ts\"",
    "lint": "eslint --max-warnings 0 .",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gg-utils/env-materialize-core.git"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
